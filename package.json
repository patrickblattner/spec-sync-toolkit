{
  "name": "spec-sync-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI toolkit that executes the mechanical parts of the worker loop: gate, queue, pack, merge, lenses, report, doctor.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spec-sync": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsup",
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "picomatch": "^4.0.4",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.21.5": true
  }
}
