{
  "project": "spec-sync-toolkit",
  "gate": {
    "profiles": {
      "local": ["format", "lint", "build", "unit"],
      "merge": ["format", "lint", "build", "unit"],
      "nightly": ["format", "lint", "build", "unit"]
    },
    "phases": [
      { "name": "format", "cmd": "npm run format:check" },
      { "name": "lint", "cmd": "npm run lint" },
      { "name": "build", "cmd": "npm run build" },
      { "name": "unit", "cmd": "npm test" }
    ]
  },
  "lenses": {
    "acceptance": ["**"],
    "tests": ["**"],
    "security": ["src/norms.ts", "package-lock.json"]
  },
  "labels": {
    "build": "spec-sync",
    "audit": "auto-audit",
    "bug": "type: bug",
    "hold": "owner-hold"
  },
  "codegraphProject": "spec-sync-toolkit"
}
